# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# --- Clerk (authentication) ---------------------------------------------
# Clerk dashboard -> your application -> Configure -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Where Clerk's hosted components live inside this app
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Neon (Postgres database) -------------------------------------------
# Neon console -> your project -> Connect -> copy the connection string.
# Server-only: do NOT rename this to NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://db_user:db_password@ep_endpoint.region.aws.neon.tech/neondb?sslmode=require
